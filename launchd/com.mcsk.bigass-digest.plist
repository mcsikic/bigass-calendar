<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 08:30 daily: publish anything unpublished, then send the digest.
       If the Mac is ASLEEP at 08:30 it runs at wake (verified: man launchd.plist,
       and observed 2026-08-12 — slept 06:44, woke 10:15:49, job ran 10:15:58).
       If the Mac is OFF all day, that day is skipped — launchd does not back-fire
       a calendar job whose time passed before it loaded.
       Install:  cp launchd/com.mcsk.bigass-digest.plist ~/Library/LaunchAgents/
                 launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mcsk.bigass-digest.plist -->
  <key>Label</key><string>com.mcsk.bigass-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mcsk/_MCSK/_DOCs/_claude/_bigass_calendar/scripts/morning.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/bigass-digest.log</string>
  <key>StandardErrorPath</key><string>/tmp/bigass-digest.log</string>
</dict>
</plist>
